{
  "name": "openproxy-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "openproxy": "openproxy/cli.mjs" },
  "scripts": {
    "test": "node --test openproxy/test/*.test.mjs",
    "start": "node openproxy/cli.mjs serve",
    "setup": "node openproxy/cli.mjs setup",
    "desktop:build": "node desktop/build.mjs --versioned",
    "desktop:verify": "node desktop/verify-package.mjs"
  }
}
